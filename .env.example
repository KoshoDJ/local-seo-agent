# Copy this file to .env and fill in what you have. Each command tells you when it needs one.
# .env is gitignored. Never commit it and never paste credentials into chat or documentation.

# --- SEO intelligence: DataForSEO ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Set the most specific supported market. Prefer location_code once resolved.
DATAFORSEO_LOCATION_CODE=
DATAFORSEO_LOCATION_NAME=
DATAFORSEO_LANGUAGE_CODE=en
# Hard per-run paid-call safeguards.
DATAFORSEO_MAX_SERP_CALLS_PER_RUN=25
DATAFORSEO_MAX_KEYWORD_CALLS_PER_RUN=50
DATAFORSEO_CACHE_DIR=data/seo-cache

# --- AI providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Airtable review / operating console ---
AIRTABLE_PERSONAL_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# --- n8n primary orchestration ---
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# Apify - /gbp-post scrapes Reddit for what buyers actually ask about.
APIFY_TOKEN=

# Pexels - photos for /build-website, /service-page and /blog-post.
PEXELS_API_KEY=

# Blotato - /blotato schedules social posts.
BLOTATO_API_KEY=

# Where contact and quote forms post.
LEAD_WEBHOOK_URL=

# Legacy/optional Make.com integration. n8n is the preferred orchestrator for the new SEO pipeline.
MAKE_API_TOKEN=
MAKE_WEBHOOK_URL=
GBP_POST_WEBHOOK_URL=
